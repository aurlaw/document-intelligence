# Cloudflare Turnstile site key (public — safe to commit)
# Dev:  test key below always passes; no setup needed
# Prod CI: set VITE_TURNSTILE_SITE_KEY as a GitHub repo *variable*
#          (Settings → Secrets and variables → Actions → Variables)
#          The Action inlines it into the bundle at build time; the Worker never sees it.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
